            using (var connection = new OleDbConnection(ConnectionString))
            {
                connection.Open();
                var query = "INSERT INTO [FilmStorage_Poster] ([NO_PENEMPATAN], [JUDUL_FILM], [PRODUKSI], [TAHUN_PRODUKSI], [Poster], [NEGARA], [BAHASA], [WARNA], [JENIS_FILM], [UKURAN_REEL_MM], [JUMLAH_REEL], [PANJANG_REEL_FT], [MASA_PUTAR_S], [RAK], [COPY], [KETERANGAN]) VALUES (@noPenempatan, @judulFilm, @produksi, @tahunProduksi, @poster, @negara, @bahasa, @warna, @jenisFilm, @ukuranReel, @jumlahReel, @panjangReel, @masaPutar, @rak, @copy, @keterangan)";
